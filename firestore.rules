rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. HELPER FUNCTIONS (HÀM KIỂM TRA ĐỊNH DANH & PHÂN QUYỀN RBAC)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@school.edu.vn' ||
        request.auth.token.email == 'admin@eduplay.vn' ||
        request.auth.token.email == 'thuthuthtk@gmail.com' ||
        request.auth.token.email == 'vanquan18189@gmail.com' ||
        request.auth.token.email == 'dangtanhung@gmail.com' ||
        request.auth.token.email.matches('(?i).*admin.*')
      );
    }

    function isAuthorizedTeacher() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.email in [
          'thuthuthtk@gmail.com',
          'vanquan18189@gmail.com',
          'dangtanhung@gmail.com',
          'hathiram@gmail.com',
          'tramduongtk@gmail.com',
          'luuminh@gmail.com',
          'buiyen@gmail.com',
          'thanhthao@gmail.com',
          'phamthanhthaotk@gmail.com',
          'tranhuuich@gmail.com',
          'diemhuong@gmail.com',
          'huongdiem18051995@gmail.com',
          'nguyenle@gmail.com',
          'hoangmai@gmail.com',
          'buituyentk@gmail.com',
          'nguyendung@gmail.com',
          'vuquang@gmail.com',
          'lelan@gmail.com',
          'admin@school.edu.vn',
          'admin@eduplay.vn'
        ] ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // Kiểm tra quyền Chủ sở hữu tài liệu
    function isContentOwner(resData) {
      return isAuthorizedTeacher() && (
        isAdmin() ||
        (resData.ownerId != null && resData.ownerId == request.auth.uid) ||
        (resData.ownerEmail != null && resData.ownerEmail == request.auth.token.email) ||
        (resData.teacherEmail != null && resData.teacherEmail == request.auth.token.email) ||
        (resData.teacherId != null && resData.teacherId == request.auth.uid)
      );
    }

    // Kiểm tra nội dung được chia sẻ cho giáo viên (theo UID/email hoặc tổ chuyên môn)
    function isSharedWithTeacher(resData) {
      return isAuthorizedTeacher() && (
        (resData.sharedWithTeachers != null && (
          request.auth.uid in resData.sharedWithTeachers ||
          request.auth.token.email in resData.sharedWithTeachers
        )) ||
        (resData.sharedWithGroups != null && resData.sharedWithGroups.size() > 0)
      );
    }

    function canReadContent(resData) {
      return isAdmin() || isContentOwner(resData) || isSharedWithTeacher(resData);
    }

    // Khi sửa nội dung được chia sẻ: cấm đổi ownerId của chủ gốc
    function isOwnerIdUnchanged() {
      return !('ownerId' in resource.data) ||
             resource.data.ownerId == null ||
             request.resource.data.ownerId == resource.data.ownerId ||
             isAdmin();
    }

    function canUpdateContent(resData) {
      return isAdmin() || (
        isOwnerIdUnchanged() && (
          isContentOwner(resData) ||
          (isSharedWithTeacher(resData) && resData.sharePermission in ['edit', 'assign'])
        )
      );
    }

    function canDeleteContent(resData) {
      return isAdmin() ||
             isContentOwner(resData) ||
             (isSharedWithTeacher(resData) && resData.allowDeleteByShared == true);
    }

    // =========================================================================
    // 2. HỒ SƠ NGƯỜI DÙNG & GIÁO VIÊN (BẢO MẬT PII: SĐT, NGÀY SINH, CCCD)
    // =========================================================================

    // Collection users: Học sinh tuyệt đối không được đọc.
    match /users/{userId} {
      allow read: if isAuthorizedTeacher();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthorizedTeacher() && (
          userId == request.auth.uid ||
          (resource.data.email != null && resource.data.email == request.auth.token.email)
        )
      );
      allow delete: if isAdmin();
    }

    // Collection teachers: Học sinh tuyệt đối không được đọc.
    match /teachers/{teacherId} {
      allow read: if isAuthorizedTeacher();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthorizedTeacher() && (
          teacherId == request.auth.uid ||
          (resource.data.email != null && resource.data.email == request.auth.token.email)
        )
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. 5 MODULE NỘI DUNG (CHỦ SỞ HỮU + CHIA SẺ CÙNG TỔ CHUYÊN MÔN)
    // =========================================================================

    // 3.1. Bài giảng E-Learning (elearning_lessons)
    match /elearning_lessons/{lessonId} {
      // Học sinh đọc bài giảng giao cho lớp; Giáo viên chỉ đọc bài của mình hoặc được chia sẻ
      allow read: if !isAuthorizedTeacher() || canReadContent(resource.data);
      allow create: if isAuthorizedTeacher();
      allow update: if canUpdateContent(resource.data);
      allow delete: if canDeleteContent(resource.data);
    }

    // 3.2. Ngân hàng câu hỏi (questions)
    match /questions/{questionId} {
      allow read: if !isAuthorizedTeacher() || canReadContent(resource.data);
      allow create: if isAuthorizedTeacher();
      allow update: if canUpdateContent(resource.data);
      allow delete: if canDeleteContent(resource.data);
    }

    // 3.3. Quản lý đề kiểm tra (exams) & bài nộp học sinh (submissions)
    match /exams/{examId} {
      allow read: if !isAuthorizedTeacher() || canReadContent(resource.data);
      allow create: if isAuthorizedTeacher();
      allow update: if !isAuthorizedTeacher() || canUpdateContent(resource.data);
      allow delete: if canDeleteContent(resource.data);

      match /submissions/{submissionId} {
        allow read, write: if true;
      }
    }

    // 3.4. Quản lý bài tập (assignments)
    match /assignments/{assignmentId} {
      allow read: if !isAuthorizedTeacher() || canReadContent(resource.data);
      allow create: if isAuthorizedTeacher();
      allow update: if !isAuthorizedTeacher() || canUpdateContent(resource.data);
      allow delete: if canDeleteContent(resource.data);

      match /submissions/{submissionId} {
        allow read, write: if true;
      }
    }

    // 3.5. Trò chơi học tập (games & quizzi_games)
    match /games/{gameId} {
      allow read: if !isAuthorizedTeacher() || canReadContent(resource.data);
      allow create: if isAuthorizedTeacher();
      allow update: if !isAuthorizedTeacher() || canUpdateContent(resource.data);
      allow delete: if canDeleteContent(resource.data);
    }

    match /quizzi_games/{quizId} {
      allow read: if !isAuthorizedTeacher() || canReadContent(resource.data);
      allow create: if isAuthorizedTeacher();
      allow update: if canUpdateContent(resource.data);
      allow delete: if canDeleteContent(resource.data);
    }

    match /quizzis/{quizId} {
      allow read: if !isAuthorizedTeacher() || canReadContent(resource.data);
      allow create: if isAuthorizedTeacher();
      allow update: if canUpdateContent(resource.data);
      allow delete: if canDeleteContent(resource.data);
    }

    // =========================================================================
    // 4. SAO LƯU DI TRÚ CHỦ SỞ HỮU (CHỈ ADMIN)
    // =========================================================================
    match /ownership_migration_backups/{backupId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 5. DỮ LIỆU LỚP HỌC, HỌC SINH & KẾT QUẢ HỌC TẬP
    // =========================================================================
    match /to_chuyen_mon/{deptId} {
      allow read: if isAuthorizedTeacher();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isAuthorizedTeacher();
    }

    match /class_rosters/{rosterId} {
      allow read: if true;
      allow write: if isAuthorizedTeacher();
      match /{allSubpaths=**} {
        allow read: if true;
        allow write: if isAuthorizedTeacher();
      }
    }

    match /students/{studentId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /student_results/{studentCode} {
      allow read, write: if true;
    }

    match /quiz_live_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /elearning_assignments/{id} {
      allow read, write: if true;
    }

    match /activity_log/{logId} {
      allow read, write: if true;
    }

    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthorizedTeacher();
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
